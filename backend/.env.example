# StackForge Backend — copy to .env and adjust

APP_NAME=StackForge API
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server
HOST=0.0.0.0
PORT=4000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=stackforge
POSTGRES_PASSWORD=stackforge_secret
POSTGRES_DB=stackforge

DATABASE_URL=postgresql+psycopg2://stackforge:stackforge_secret@postgres:5432/stackforge

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Seeding
SEED_DEMO_DATA=true
