# Copy to .env in this directory (stackforge/) before: docker compose up --build

# PostgreSQL (service name: db)
POSTGRES_USER=stackforge
POSTGRES_PASSWORD=stackforge_secret
POSTGRES_DB=stackforge

# Backend
DATABASE_URL=postgresql+psycopg2://stackforge:stackforge_secret@db:5432/stackforge
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000
SEED_DEMO_DATA=true

# Frontend (browser + Next.js proxy)
# API calls from the browser go to /api/v1 on the frontend; Next proxies to backend.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8000/api/v1
BACKEND_INTERNAL_URL=http://backend:8000
