# ==============================================================================
# StackForge — Kubernetes Secret Example Manifest
# ==============================================================================
# Copy this file to `k8s/secret.yaml` for local development on Minikube or kind:
#   cp k8s/secret.yaml.example k8s/secret.yaml
#
# SECURITY WARNING:
# NEVER commit populated secret files or production credentials to Git.
# `k8s/secret.yaml` is ignored by Git to prevent accidental commits.
# Previously committed historical credentials must be considered compromised
# and must NOT be reused in production environments.
#
# For production or automated deployments, provision secrets via CI/CD,
# HashiCorp Vault, AWS Secrets Manager, or `kubectl create secret`:
#   kubectl create secret generic stackforge-secrets -n stackforge \
#     --from-literal=POSTGRES_PASSWORD='<secure-password>' \
#     --from-literal=DATABASE_URL='postgresql+psycopg2://stackforge:<secure-password>@db:5432/stackforge' \
#     --from-literal=JWT_SECRET_KEY='<secure-64-char-random-key>'
# ==============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: stackforge-secrets
  namespace: stackforge
  labels:
    app.kubernetes.io/name: stackforge
    app.kubernetes.io/part-of: stackforge
type: Opaque
stringData:
  POSTGRES_PASSWORD: "replace-with-a-secure-database-password"
  DATABASE_URL: "postgresql+psycopg2://stackforge:replace-with-a-secure-database-password@db:5432/stackforge"
  JWT_SECRET_KEY: "replace-with-a-secure-random-64-character-jwt-secret-key"
